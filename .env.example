# Required: Google API key for Gemini 3 Pro
GOOGLE_API_KEY=your_gemini_api_key_here

# REAPER connection settings (defaults shown)
REAPER_HOST=localhost
REAPER_PORT=9000

# Recreation loop settings (defaults shown)
MAX_ITERATIONS=10
QUALITY_THRESHOLD=0.8

# Analysis settings (defaults shown)
ANALYSIS_WORKERS=4
