# Required: Google API key for Gemini 3 Pro
GOOGLE_API_KEY=your_gemini_api_key_here
# Required: Tell ADK to use API key instead of Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# REAPER connection settings (defaults shown)
REAPER_HOST=localhost
REAPER_PORT=9000

# Recreation loop settings (defaults shown)
MAX_ITERATIONS=10
QUALITY_THRESHOLD=0.8

# Analysis settings (defaults shown)
ANALYSIS_WORKERS=4

# Langfuse observability (optional)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
